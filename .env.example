# 复制本文件为 .env 并填入你的真实 key(记得把 .env 加进 .gitignore)
# 申请地址:https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选:AI 的工作区目录,必须是本项目内的子目录(默认 workspace)
# 不允许填项目根目录或项目外的路径,否则启动时会直接报错退出
# AGENT_WORKSPACE=workspace

# 可选:搜索服务。不配置的话 web_search 工具会直接报错,其余功能不受影响
#   tavily      —— 海外,为 LLM 设计,返回带正文摘要;需要 key
#   bocha       —— 国内(博查),中文结果更好,国内直连更稳;需要 key
#   duckduckgo  —— 免费无需 key,但需 pip install ddgs,国内直连大概率不通
# SEARCH_PROVIDER=bocha
# SEARCH_API_KEY=

# 可选:QEMU 虚拟机沙箱。目录布局:
#   vm/qemu/                  QEMU 本体(qemu-system-x86_64.exe、qemu-img.exe 及依赖的
#                             DLL 与 share/ 固件 —— share/ 必须挨着 exe,QEMU 靠它找 BIOS)
#   vm/alpine-vmserver.qcow2  基础盘,预装 vmserver,只读共享
#   vm/base-clean.qcow2       干净 Alpine 底本,留着以便重建基础盘(仓库里没有烤制脚本)
#   sessions/<会话 id>/        运行时的 overlay 磁盘(每个会话一块,见 agent/session.py)
# vmserver 是 guest 里的管理服务端,agent 通过 socket 连它执行命令。
# VM_QEMU_DIR=vm/qemu             # QEMU 本体目录(含 qemu-system-x86_64.exe)
# VM_QEMU_SYSTEM=vm/qemu/qemu-system-x86_64.exe
# VM_QEMU_IMG=vm/qemu/qemu-img.exe
# VM_BASE=vm/alpine-vmserver.qcow2  # vmserver 基础盘(全体共享、只读)
# VM_DIR=vm                        # 镜像目录(基础盘在这;overlay 在会话目录里)
# VM_ACCEL=whpx                    # 加速;没开 whpx 就设 tcg(慢但通用)
# VM_AUTOSTART=0                   # 会话启动时要不要顺手把虚拟机拉起来。**默认 0(不拉)**:
#                                  它是台完整机器,多数会话用不到,白占内存和一块盘。
#                                  要用时 vm_start 即可(十几秒)。设 1 则每次启动都拉。
#                                  只影响隐式启动;/vmreset 和 vm_start 不受影响。
# 注:宿主导(串口/vmserver 口)由程序动态分配(3000/5000 起找空闲),多开不撞车,一般无需配置
