.venv/
.env
__pycache__/
*.pyc
# pytest 的缓存目录(测试跑完就在仓库根冒出来,不该进版本库)
.pytest_cache/
# coverage 的数据文件(同上)
.coverage
workspace/
# agent 的另一个工作区(.env 里 AGENT_WORKSPACE=temp 时用它)。和 workspace/ 同理:
# 里面有它自管的 .git、克隆进来的仓库、pip 持久化的包 —— 绝不进项目仓库。
# 换了 AGENT_WORKSPACE 的话,记得把新目录也加到这里。
temp/
# QEMU 本体(500M+)与虚拟机镜像(各约 300M),都是本地资源,不进仓库
vm/
# 会话数据:对话历史(私密内容)+ 每个会话的虚拟机磁盘(可能上 GB),绝不能提交
sessions/
# Claude Code 的本地配置与状态(权限、本机路径等,与项目源码无关)
.claude/
